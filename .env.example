# Backblaze B2 Configuration (required)
# Set these in Vercel dashboard → Settings → Environment Variables
BACKBLAZE_KEY_ID=your_backblaze_key_id
BACKBLAZE_APPLICATION_KEY=your_backblaze_application_key
BACKBLAZE_BUCKET_NAME=your_bucket_name

# Optional: Custom API Base URL (defaults to /api for same-domain)
# Only needed if deploying API routes to a different domain
# VITE_API_BASE_URL=https://api.yourdomain.com

# Supabase Configuration (required for user management sync across devices)
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# For Vercel serverless functions (same values as above, different names)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Required once Row Level Security is enabled (see
# supabase/migrations/0001_enable_rls.sql) - api routes use this instead of
# the anon key so they can bypass RLS, while the public anon key is denied
# by every policy. Get it from Supabase → Settings → API → service_role.
# NEVER prefix this with VITE_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS: comma-separated list of origins allowed to call the API
# (your production domain, and http://localhost:8080 for local dev)
ALLOWED_ORIGIN=https://mb-adminside.vercel.app,http://localhost:8080

# Hardcoded admin account password hashes (bcrypt).
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# Do NOT put a plain-text password here or anywhere else.
ADMIN_PASSWORD_HASH=
BRIAN_PASSWORD_HASH=

# Admin mode code (bcrypt hash), checked on the server.
# Users who are NOT one of the two admin accounts above must enter this code
# to switch admin mode on (edit the portal layout, delete files). The admin
# accounts can switch it on without the code. Leave empty to allow only the
# admin accounts. Use a new code - the old one was readable in the browser.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-code', 10))"
ADMIN_CODE_HASH=

# Optional: secret used to sign admin-mode tokens. Defaults to
# SUPABASE_SERVICE_ROLE_KEY when not set.
# ADMIN_TOKEN_SECRET=

# Maileroo SMTP Configuration (for email notifications)
# Get these from Maileroo Dashboard → Sending Domains → SMTP Credentials
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_USER=your-maileroo-smtp-username
SMTP_PASS=your-maileroo-smtp-password
SMTP_FROM_EMAIL=noreply@your-verified-domain.com
SMTP_FROM_NAME=Måløv Boldklub

